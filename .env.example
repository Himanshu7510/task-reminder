# Login password for the dashboard
ADMIN_PASSWORD=change-me
# Random string used to sign login cookies
AUTH_SECRET=some-long-random-string

# Email (Gmail: use an App Password from https://myaccount.google.com/apppasswords)
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="Reminders <you@gmail.com>"
# ...or use Resend instead of SMTP:
# RESEND_API_KEY=re_...

# Receives a daily digest of everything sent / overdue
ADMIN_EMAIL=you@gmail.com

# Protects /api/cron (Vercel sends it automatically as a Bearer token)
CRON_SECRET=another-random-string

# Storage — added automatically when a Vercel Blob store is connected
# BLOB_READ_WRITE_TOKEN=

# Time zone for "today" (default Asia/Kolkata)
# APP_TZ=Asia/Kolkata
